[{"formula":"A^T nu = 0","id":"CHEM-001","name":"Закон сохранения атомов"},{"formula":"z^T nu = 0","id":"CHEM-002","name":"Закон сохранения электрического заряда в реакции"},{"formula":"r = (1/nu_i) d xi_i/dt","id":"CHEM-003","name":"Определение скорости реакции со стехиометрией"},{"formula":"r = k prod_i a_i^alpha_i","id":"CHEM-004","name":"Закон действующих масс для элементарной стадии"},{"formula":"k = A exp(-E_a/(R T))","id":"CHEM-005","name":"Уравнение Аррениуса"},{"formula":"k = (k_B T/h) exp(-Delta G^ddagger/(R T))","id":"CHEM-006","name":"Уравнение Эйринга"},{"formula":"mu_i = mu_i^0 + R T ln(a_i)","id":"CHEM-007","name":"Химический потенциал через активность"},{"formula":"Delta_r G^0 = - R T ln(K^0)","id":"CHEM-008","name":"Связь константы равновесия и энергии Гиббса"},{"formula":"Delta_r G = sum_i nu_i mu_i = 0","id":"CHEM-009","name":"Условие химического равновесия"},{"formula":"d ln(K)/dT = Delta_r H^0/(R T^2)","id":"CHEM-010","name":"Уравнение Вант-Гоффа"},{"formula":"E = E^0 - (R T/(n F)) ln(Q)","id":"CHEM-011","name":"Уравнение Нернста"},{"formula":"n_i = I t/(z_i F)","id":"CHEM-012","name":"Закон Фарадея электролиза"},{"formula":"A = epsilon l c","id":"CHEM-013","name":"Закон Бугера–Ламберта–Бера"},{"formula":"p_i = k_H x_i","id":"CHEM-014","name":"Закон Генри"},{"formula":"p_i = x_i p_i^*","id":"CHEM-015","name":"Закон Рауля"},{"formula":"dP/dT = Delta S/Delta V","id":"CHEM-016","name":"Уравнение Клапейрона"},{"formula":"d ln(P)/dT = Delta H/(R T^2)","id":"CHEM-017","name":"Уравнение Клаузиуса–Клапейрона"},{"formula":"sum_i n_i d mu_i = -S dT + V dP","id":"CHEM-018","name":"Уравнение Гиббса–Дюгема"},{"formula":"d(Delta G/T)/dT = -Delta H/T^2","id":"CHEM-019","name":"Уравнение Гиббса–Гельмгольца"},{"formula":"K_a = alpha^2 c/(1-alpha)","id":"CHEM-020","name":"Закон разбавления Оствальда"},{"formula":"v = V_max S/(K_M + S)","id":"CHEM-021","name":"Уравнение Михаэлиса–Ментен"},{"formula":"J_i = -D_i grad(c_i)","id":"CHEM-022","name":"Закон Фика для химического потока"},{"formula":"d(Q) = (L^aL,M^aM,T^aT,I^aI,Theta^aTheta,N^aN,J^aJ)","id":"MET-001","name":"Вектор размерности SI"},{"formula":"Sigma_y = J Sigma_x J^T","id":"MET-002","name":"Распространение ковариации первого порядка"},{"formula":"u(x_bar) = s/sqrt(n)","id":"MET-003","name":"Стандартная неопределённость среднего"},{"formula":"u_c^2(y) = sum_i sum_j (partial f/partial x_i)(partial f/partial x_j) u(x_i,x_j)","id":"MET-004","name":"Комбинированная стандартная неопределённость"},{"formula":"U = k u_c","id":"MET-005","name":"Расширенная неопределённость"},{"formula":"y = f(x,beta) + epsilon","id":"MET-006","name":"Калибровочная модель"},{"formula":"d(term_1) = d(term_2) = ... = d(term_n)","id":"MET-007","name":"Условие размерностной однородности"},{"formula":"F(Q_1,...,Q_n)=0 iff F'(Q'_1,...,Q'_n)=0","id":"MET-008","name":"Инвариантность физического закона к смене согласованных единиц"}]